---
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: className } = Astro.props;
---

<!-- Shree Ratna Ghar mark: gold gem ("ratna" = jewel) with royal-facet accents -->
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- gem outline: crown, girdle, pavilion -->
  <path d="M13 9 L35 9 L45 18.5 L24 41.5 L3 18.5 Z" stroke="#D4AF37" stroke-width="2.4" stroke-linejoin="round"/>
  <!-- girdle line -->
  <path d="M3 18.5 L45 18.5" stroke="#D4AF37" stroke-width="1.5" opacity="0.9"/>
  <!-- royal facets inside the crown & pavilion -->
  <path d="M13 9 L21 18.5 L24 41.5 M35 9 L27 18.5 L24 41.5" stroke="#3E6FB8" stroke-width="1.5" stroke-linejoin="round"/>
  <!-- girdle node -->
  <circle cx="45" cy="18.5" r="2.2" fill="#D4AF37"/>
</svg>
