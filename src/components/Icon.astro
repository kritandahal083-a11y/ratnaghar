---
import { resolveIcon } from '../lib/iconData';

interface Props {
  /** Iconify name, e.g. "ph:code" or "simple-icons:linkedin" */
  name: string;
  size?: number;
  /** Accessible label; omit for decorative icons (hidden from AT). */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const { viewBox, body } = resolveIcon(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
