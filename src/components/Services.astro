---
import Icon from './Icon.astro';
import { SERVICE_GROUPS } from '../data/services';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section class="services" id="services">
  <div class="container">
    <div class="svc__head" data-reveal>
      <p class="label">What we do</p>
      <h2 class="display-2">Ten disciplines.<br/>One operating standard.</h2>
      <p class="svc__intro">
        Everything below is delivered by our own team. Open a discipline to see exactly what we
        handle — then tell us where your project fits.
      </p>
    </div>

    {
      SERVICE_GROUPS.map((group) => (
        <div class="svc__group" data-reveal>
          <div class="svc__group-head">
            <h3 class="svc__group-label">{group.label}</h3>
            <p class="svc__group-blurb">{group.blurb}</p>
          </div>

          <ul class="svc__list">
            {group.services.map((s) => (
              <li class="svc" data-service-name={s.name}>
                <h4>
                  <button
                    class="svc__row"
                    aria-expanded="false"
                    aria-controls={`svc-panel-${slug(s.name)}`}
                  >
                    <span class="svc__icon">
                      <Icon name={s.icon} size={24} />
                    </span>
                    <span class="svc__title">{s.name}</span>
                    <span class="svc__hint">{s.intro}</span>
                    <span class="svc__plus" aria-hidden="true">
                      <Icon name="ph:plus" size={17} />
                    </span>
                  </button>
                </h4>
                <div class="svc__panel" id={`svc-panel-${slug(s.name)}`}>
                  <div class="svc__panel-in">
                    <ul class="svc__caps">
                      {s.capabilities.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                    <a class="link-more" href="#contact" data-service={s.name}>
                      Start this project
                      <Icon class="icon-arrow" name="ph:arrow-right" size={15} />
                    </a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="svc__note" data-reveal>
      <span class="svc__note-node" aria-hidden="true"></span>
      Not sure which discipline you need? That's the first conversation — <a
        href="#contact">tell us the goal<span class="visually-hidden">, open contact form</span></a>
      , and we'll map it.
    </p>
  </div>
</section>

<script>
  const root = document.getElementById('services');

  const entries = Array.from(root?.querySelectorAll<HTMLElement>('.svc') ?? []);

  const setPanelHeight = (li: HTMLElement, open: boolean) => {
    const panel = li.querySelector<HTMLElement>('.svc__panel');
    const button = li.querySelector<HTMLButtonElement>('.svc__row');
    if (!panel || !button) return;

    button.setAttribute('aria-expanded', String(open));
    li.classList.toggle('is-open', open);

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (open) {
      panel.style.height = `${panel.scrollHeight}px`;
      if (!reduced) {
        panel.addEventListener('transitionend', () => (panel.style.height = "auto"), { once: true });
      }
    } else {
      /* from auto → fixed px → 0, so the collapse animates */
      if (panel.style.height === 'auto') panel.style.height = `${panel.scrollHeight}px`;
      requestAnimationFrame(() => panel.style.height = '0px');
    }
  };

  /* Closed by default */
  entries.forEach((li) => {
    const panel = li.querySelector<HTMLElement>('.svc__panel');
    if (panel) panel.style.height = '0px';
  });

  root?.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('.svc__row');
    if (!button) return;
    const li = button.closest<HTMLElement>('.svc');
    if (!li) return;

    const willOpen = button.getAttribute('aria-expanded') !== 'true';
    setPanelHeight(li, willOpen);

    /* One open at a time */
    entries.forEach((other) => {
      if (other !== li && other.classList.contains('is-open')) setPanelHeight(other, false);
    });
  });

  /* "Start this project" pre-fills the contact form's service select */
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-service]');
    if (!link) return;
    const select = document.getElementById('f-service') as HTMLSelectElement | null;
    if (!select) return;
    select.value = link.dataset.service ?? '';
    select.dataset.touched = 'true';
  });
</script>

<style>
  .services { padding-block: var(--sec-y); }
  .services li { list-style: none; }

  .svc__head { max-width: 60rem; }
  .svc__head .label { margin-bottom: 1.2rem; }
  .svc__intro {
    margin-top: 1.2rem;
    max-width: 47ch;
    color: var(--muted-c);
  }

  .svc__group { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .svc__group-head {
    display: flex;
    align-items: baseline;
    gap: 1.6rem;
    padding-bottom: 0.9rem;
  }
  .svc__group-label {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 620;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-ink);
    flex-shrink: 0;
  }
  .svc__group-blurb {
    font-size: 0.9rem;
    color: var(--muted-c);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.9rem;
    width: 100%;
  }

  .svc__list { border-top: 1px solid var(--line); }

  .svc { border-bottom: 1px solid var(--line); }

  .svc__row {
    display: grid;
    grid-template-columns: 3rem minmax(11rem, 16.5rem) 1fr 2rem;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    width: 100%;
    text-align: left;
    padding: 1.35rem 0.1rem;
    transition: background-color 0.3s var(--ease);
  }
  .svc__row:hover { background: rgba(247, 249, 252, 0.9); }

  .svc__icon {
    color: var(--royal);
    display: inline-flex;
    transition: color 0.3s var(--ease), transform 0.45s var(--ease);
  }
  .svc.is-open .svc__icon,
  .svc__row:hover .svc__icon { color: var(--gold-ink); }

  .svc__title {
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 1rem + 0.5vw, 1.38rem);
    font-weight: 560;
    color: var(--heading);
    line-height: 1.25;
  }
  .svc__hint {
    color: var(--muted-c);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .svc__plus {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line-strong);
    color: var(--heading);
    transition: transform 0.35s var(--ease), background-color 0.3s var(--ease);
  }
  .svc.is-open .svc__plus {
    transform: rotate(45deg);
    background: var(--gold);
    border-color: var(--gold);
    color: #0B1F3A;
  }

  .svc__panel {
    height: 0;
    overflow: hidden;
    transition: height 0.45s var(--ease);
  }
  .svc.is-open .svc__panel { border-bottom: 0; }
  .svc__panel-in {
    display: grid;
    grid-template-columns: minmax(7rem, 15rem);
    grid-auto-rows: auto;
    gap: 0.65rem 1.2rem;
    padding: 0.4rem 0.1rem 1.7rem calc(3rem + clamp(0.8rem, 2vw, 1.6rem));
  }
  .svc__panel-in .link-more { grid-column: 2; justify-self: start; }

  .svc__caps {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 21rem));
    gap: 0.5rem 2.4rem;
  }
  .svc__caps li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: var(--body-c);
  }
  .svc__caps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--gold);
  }

  .svc__note {
    margin-top: 3rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--muted-c);
    font-size: 0.97rem;
  }
  .svc__note-node {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    transform: rotate(45deg);
    background: var(--gold);
  }
  .svc__note a { color: var(--gold-ink); font-weight: 600; }
  .svc__note a:hover { text-decoration: underline; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 62rem) {
    .svc__group-head { flex-direction: column; gap: 0.4rem; }
    .svc__group-blurb { padding-bottom: 0.6rem; }

    .svc__row {
      grid-template-columns: 2.6rem 1fr 2rem;
      grid-template-areas:
        'icon title plus'
        'hint hint hint';
      row-gap: 0.55rem;
      padding-block: 1.15rem;
    }
    .svc__icon { grid-area: icon; }
    .svc__title { grid-area: title; }
    .svc__plus { grid-area: plus; }
    .svc__hint { grid-area: hint; }
    .svc__panel-in { padding-left: 0; }
    .svc__panel-in .link-more { grid-column: 1; }
  }
</style>
